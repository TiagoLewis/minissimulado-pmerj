{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/img/:file*", "destination": "https://preparatoriopmerj.institutosouto.com.br/img/:file*" }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
